# Salin file ini jadi .env.local lalu isi nilainya. File .env.local TIDAK ikut ke GitHub.
# Semua variabel bersifat opsional. Kalau dikosongkan, aplikasi tetap jalan memakai data lokal.

# Sumber data menu. Kosong = pakai public/menu.json
# Contoh MockAPI: https://xxxxxxxx.mockapi.io/products
VITE_API_URL=

# Layanan penerima form (Formspree / MockAPI). Kosong = hanya disimpan di localStorage
VITE_ORDER_URL=
VITE_RESERVATION_URL=
VITE_REVIEW_URL=